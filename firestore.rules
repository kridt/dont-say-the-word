// Regler til "Sig ikke ordet".
// Firebase Console -> Build -> Firestore Database -> Rules -> indsæt -> Publish.
//
// Spillerne har ingen konti, så alt sker uden login. Rækkerne er med vilje
// åbne — der ligger kun ord til et selskabsspil i dem. Valideringen herunder
// holder dokumenterne i den form, spillet forventer, og lægger loft over,
// hvor meget nogen kan proppe ind.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{code} {
      allow read: if true;

      allow create, update: if code.size() == 4
        && request.resource.data.keys().hasOnly(
             ['status', 'host', 'turnSeconds', 'active', 'teams'])
        && request.resource.data.status in ['lobby', 'playing', 'done']
        && request.resource.data.host is string
        && request.resource.data.turnSeconds is int
        && request.resource.data.active is int
        && request.resource.data.teams.size() == 2;

      allow delete: if true;

      match /words/{wordId} {
        allow read, delete: if true;

        allow create: if request.resource.data.keys().hasOnly(['text', 'by', 'at'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 40
          && request.resource.data.by is string;

        allow update: if false;  // et ord rettes ikke — det slettes og skrives igen
      }
    }
  }
}
